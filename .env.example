DATABASE_URL="postgresql://cucumar:cucumar@localhost:5432/cucumar?schema=public"

# Direct (unpooled) connection, used by the Prisma CLI for migrations/studio/seed —
# see prisma.config.ts. Only needed on Vercel+Neon, where the Neon integration injects
# it automatically; omit locally and the CLI falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

OPENAI_API_KEY=""
OPENALEX_API_KEY=""

# Optional — model used by lib/providers/llm.ts for evidence classification.
# Defaults to "gpt-4o-mini" in code if unset.
OPENAI_MODEL=""

# Optional — max results lib/providers/evidence.ts requests per OpenAlex search.
# Defaults to 30 in code if unset.
EVIDENCE_SEARCH_LIMIT="30"
